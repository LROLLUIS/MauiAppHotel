<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Contratação da Hospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="10"
                             Spacing="10">

            <!-- Cabeçalho personalizado -->
            <Label Text="Hotel Recanto do Sol"
                   FontFamily="Kalam"
                   FontSize="40"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}" />

            <Label Text="Cálculo da Diária"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Gray600}" />

            <Frame Padding="10" CornerRadius="15" BorderColor="{StaticResource Primary}">
                <VerticalStackLayout>
                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *, 2*"
                          RowSpacing="10">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Adultos:"
                               VerticalOptions="Center" />

                        <Label Grid.Row="0" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_adultos}"/>

                        <Stepper Grid.Row="0" Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="1"
                                 Maximum="10"
                                 Increment="1"
                                 Value="1" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Crianças:"
                               VerticalOptions="Center" />

                        <Label Grid.Row="1" Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_criancas}"/>

                        <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />
                    </Grid>

                    <Frame Padding="10" Margin="10" CornerRadius="10">
                        <VerticalStackLayout>

                            <Label Text="Escolha sua Suíte"
                                   TextTransform="Uppercase"
                                   FontSize="Subtitle"
                                   TextColor="{StaticResource Primary}"/>

                            <Picker x:Name="pck_quarto"
                                    Title="Selecione sua Acomodação"
                                    ItemDisplayBinding="{Binding Descricao}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame Padding="10" Margin="10" CornerRadius="10">
                        <VerticalStackLayout Spacing="10">

                            <Label Text="Período da Estadia"
                                   TextTransform="Uppercase"
                                   FontSize="Subtitle"
                                   TextColor="{StaticResource Primary}"/>

                            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                                <Label Text="Check-in:" VerticalOptions="Center" />
                                <DatePicker x:Name="dtpck_checkin"
                                            DateSelected="dtpck_checkin_DateSelected"
                                            Format="dd/MM/yyyy" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                                <Label Text="Check-out:" VerticalOptions="Center" />
                                <DatePicker x:Name="dtpck_checkout"
                                            Format="dd/MM/yyyy" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <Button Text="Avançar"
                            CornerRadius="20"
                            Clicked="Button_Clicked" />

                </VerticalStackLayout>
            </Frame>

            <!-- Nova tela: Sobre -->
            <Button Text="Sobre o App"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="1"
                    CornerRadius="20"
                    Clicked="Sobre_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
