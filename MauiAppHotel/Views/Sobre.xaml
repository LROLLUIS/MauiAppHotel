<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="20"
                             Spacing="15">

            <Image Source="dotnet_bot.png"
                   HeightRequest="150"
                   Aspect="AspectFit" />

            <Label Text="Sobre o App"
                   FontFamily="Kalam"
                   FontSize="40"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="15" CornerRadius="15" BorderColor="{StaticResource Primary}">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                      ColumnDefinitions="Auto, *"
                      RowSpacing="10"
                      ColumnSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0" Text="Aplicativo:" FontAttributes="Bold" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Hotel Recanto do Sol"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Desenvolvedor:" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="Luis Reginaldo Lima"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Ano:" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="2026"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Curso:" FontAttributes="Bold" />
                    <Label Grid.Row="3" Grid.Column="1" Text="Desenvolvimento de Sistemas – ETEC (EAD)"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Tecnologia:" FontAttributes="Bold" />
                    <Label Grid.Row="4" Grid.Column="1" Text=".NET MAUI / C# / XAML"
                           TextColor="{StaticResource Primary}" />
                </Grid>
            </Frame>

            <Label Text="Aplicativo para cálculo do valor da hospedagem, de acordo com a suíte escolhida, a quantidade de hóspedes e o período da estadia."
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Gray600}" />

            <Button Text="Voltar"
                    CornerRadius="20"
                    HorizontalOptions="Center"
                    Clicked="Voltar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
